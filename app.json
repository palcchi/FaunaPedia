{
  "expo": {
    "name": "FaunaPedia",
    "slug": "faunapedia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/faunapedia-icon.png",
    "scheme": "faunapedia",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/faunapedia-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D5016"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.faunapedia"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/faunapedia-adaptive.png",
        "backgroundColor": "#2D5016"
      },
      "package": "com.yourname.faunapedia"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}